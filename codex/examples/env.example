# Copy the lines you need into ~/.codex/.env — Codex runs the notify hook
# with a bare environment, so this file is where its config lives.
# All the HIGGS_* variables from claude-code/examples/env.example work here too.

# Be addressed by name in the spoken recap
# HIGGS_RECAP_NAME=Silou

# Codex's own voice (any Higgs preset), distinct from Claude Code's
# CODEX_VOICE=en_woman

# Where the shared TTS engine lives, if not ~/.claude/hooks/utils/tts/higgs_tts.py
# CODEX_TTS_ENGINE=/path/to/higgs_tts.py

# Chain the raw payload to another notifier executable (e.g. a desktop
# notification app this hook replaced)
# CODEX_NOTIFY_FORWARD=/path/to/original/notifier

# Silence Codex recaps only (HIGGS_TTS_ENABLED=0 silences everything)
# CODEX_TTS_ENABLED=0
