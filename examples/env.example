# Copy the lines you need into ~/.claude/.env
# (loaded explicitly by the hook, whatever repo you're working in)

# Required for Higgs Audio — get a key at https://boson.ai (or leave unset to
# use the free offline macOS `say` fallback)
BOSON_API_KEY=your-key-here

# Be addressed by name in the spoken recap: "<Name>, here on <repo>, ..."
# HIGGS_RECAP_NAME=Silou

# Force one preset voice everywhere (overrides ~/.claude/tts-voices.json)
# HIGGS_VOICE=belinda

# Shape the delivery — the API honors natural-language instructions
# HIGGS_INSTRUCTIONS=speak softly and warmly

# Playback tuning
# HIGGS_SPEED=1.15
# HIGGS_VOLUME_BOOST=10
# HIGGS_MAX_SECONDS=45

# Kill switch (recaps stay silent while set)
# HIGGS_TTS_ENABLED=0

# Self-host: point at a local mlx-audio server instead of the paid API
# HIGGS_API_URL=http://localhost:8000/v1/audio/speech
